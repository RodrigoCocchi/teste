# IA
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Banco e filas
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# Segurança
# AUTH_SECRET: openssl rand -base64 48
AUTH_SECRET=
# CONNECTOR_ENCRYPTION_KEY (32 bytes): openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=

# App
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Origens extras aceitas por CORS/auth (o app Android usa capacitor://localhost e https://localhost)
TRUSTED_ORIGINS=capacitor://localhost,https://localhost,http://localhost
SEED_DEMO=true

# Login social (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Usuário dono do tenant demo (pnpm --filter @nexus/api seed:demo-user)
DEMO_USER_EMAIL=demo@vertice.demo
DEMO_USER_PASSWORD=

# Produção (docker-compose.prod.yml)
DOMAIN=
POSTGRES_PASSWORD=
